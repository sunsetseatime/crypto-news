# Vercel dashboard (Next.js) + chat
# - The dashboard UI is loaded from your GitHub Pages reports.
# - The chat API runs on Vercel serverless (never expose OPENAI_API_KEY client-side).

# Where your GitHub Pages site is published (no trailing slash)
REPORTS_BASE_URL=https://sunsetseatime.github.io/crypto-news

# OpenAI key for chat
OPENAI_API_KEY=your_key_here
OPENAI_MODEL_CHAT=gpt-4o-mini
# Model used when the in-dashboard chat has "Research mode" turned ON
# - Default: gpt-5.2 (change this if your account does not have access)
OPENAI_MODEL_CHAT_RESEARCH=gpt-5.2

# Simple protection for a public repo: required for /api/chat
CHAT_PASSWORD=choose_a_strong_password

# Optional: CoinGecko key for chat (helps with "what does this project do?" questions)
# - If you already have a CoinGecko API key for scans, you can reuse it here.
COINGECKO_API_KEY=
COINGECKO_API_KEY_HEADER=x_cg_demo_api_key
# Optional: throttle CoinGecko calls (demo keys are often limited to ~30 requests/minute)
COINGECKO_RPM=25

# Scanner tuning (optional)
# - Target size for your long-term core list (KEEP)
KEEP_TARGET_MIN=15
KEEP_TARGET_MAX=20
# - Paper trading: how much recent activity to show
PAPER_RECENT_WINDOW_DAYS=60

# Scanner env vars for local runs are documented in readme/README.md
